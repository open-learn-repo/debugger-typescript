{
	"version": "2.0.0",
	"tasks": [
    {
      "type": "shell",
			"command": "tsc",
			"args": ["--project", "${workspaceFolder}\\tsconfig.json"],
      "problemMatcher": ["$tsc"],
      "group": "build",
      "label": "tsc:build"
    },
		{
			"type": "shell",
			"command": "rimraf",
			"args": ["'compile/**/*.{js,map}'", "-g"],
			"problemMatcher": [],
			"group": "build",
			"label": "rimraf:clean-tsc-compileFile",
		}
	]
}