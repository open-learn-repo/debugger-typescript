{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
		"rootDir": "./src",
    "outDir": "./compile",
    "allowArbitraryExtensions": true
  }
}
